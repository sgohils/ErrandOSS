# ErrandOS Environment Variables
# Copy this file to .env and fill in your values

# Backend
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# AI Provider (optional - app works without it)
AI_PROVIDER=anakin
AI_API_KEY=your_ai_api_key_here
AI_MODEL=default

# Geocoding (optional - fallback to manual entry)
GEOCODING_API_KEY=your_geocoding_api_key_here

# Routing / OSRM (optional - fallback to haversine estimates)
OSRM_BASE_URL=http://router.project-osrm.org

# Mapbox (optional - fallback to Leaflet + OpenStreetMap)
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# Vehicle settings (demo defaults)
DEFAULT_MPG=25
DEFAULT_FUEL_PRICE=3.50
